. 
. /* Table 9: Heterogeneous responses*/
. /* Interact with % black at nearest high school before desegregation (in 1970)*/
. sort borderno jurcode

. by borderno jurcode: egen perenr_bl1970=mean(perenr_black1)
(2220 missing values generated)

. gen big1980per=big1980*perenr_bl1970
(2220 missing values generated)

. gen yesbig1980per=yesbig1980*perenr_bl1970
(2220 missing values generated)

. /* Interaction with actual black enrollment in 1970*/
. areg lnavval big1980 yesbig1980 big1980per yesbig1980per A* if tierno<2 [aw=house_ownocc], absorb(extra) cluster(jurcode)
