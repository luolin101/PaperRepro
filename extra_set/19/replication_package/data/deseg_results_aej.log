tract1 was float now double
borderno was int now float
av_value was float now double
county_text was str12 now str13
name was str23 now str26
peredhs was float now double
peredcol was float now double
perpov was float now double

. 
. ** ADJUST DATA TO MAKE CONSISTENT BETWEEN TWO YEARS
. 
. /* (1) Ensure consistent jurisdiction sample in 1970 and 1980 */
. /* Drop South (Georgia)*/
. drop if statefip==13
(125 observations deleted)

. /* Drop NYC-Floral Park (Floral Park too small - jurisdiction data not available)*/
. drop if borderno==44
(88 observations deleted)

. /* Make sure that St. Louis jurisdiction code is consistent across years*/
. replace jurcode="stlouimo" if year==1970 & jurcode=="sailoumo"
(22 real changes made)

. /* Drop borders for which jurisdiction on one side is smaller than 10,000 residents */
. gen flag_lowpop=(poptot<10000)

. sort year borderno

. quietly by year borderno: egen flag_lowpop_any=max(flag_lowpop)

. drop if flag_lowpop_any==1
(0 observations deleted)

. /* Drop borders if only one side has data in a given year*/
. sort year borderno jurcode

. gen test=(jurcode!=jurcode[_n-1])

. sort year borderno

. by year borderno: egen test1=sum(test)

. drop if test1==1
(1116 observations deleted)

. count if test==1
  358

. drop test* flag*

. /* Drop borders only present in 1970 or 1980*/
. sort year borderno

. gen test=(borderno!=borderno[_n-1])

. sort borderno

. by borderno: egen test1=sum(test)

. drop if test1==1
(2892 observations deleted)

. count if test==1
