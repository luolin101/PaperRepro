. /* (5) Desegregation variables*/
. /* Focus on number of steps required by court (not on presence of individual steps, such as busing). First, create a 
> district-level variable equal to maximum number of steps _ever_ required by court*/
. sort jurcode

. quietly by jurcode: egen number_stepsm=max(number_steps)

. sort borderno jurcode

. by borderno jurcode: egen year_casem=max(year_case)
(8778 missing values generated)

. /*Year specific desegregation variables = maximum number of variable in given year and zero else*/
. gen Cyear_1970=(year==1970)

. gen Cyear_1980=(year==1980)

. foreach var of varlist shblack lnmedinc number_stepsm perpov {
  2.         gen `var'70=`var'*Cyear_1970
  3.         gen `var'80=`var'*Cyear_1980
  4. }       
(19 missing values generated)
(19 missing values generated)
