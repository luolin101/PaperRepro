. /*
> /** The riots data are not included in the AEJ data archive. Please contact Bob Margo (margora@bu.edu) or Bill Collins 
> (william.collins@vanderbilt.edu) for access to the data **/
> /* Merge in the riots data by metro area*/
> #delimit cr
> drop _merge
> sort metaread
> merge metaread using ~/Tract_block/Riots_data/riots_touse_01.dta
> /* Define riot to be zero in 1970 and actual value in 1980. Always zero for suburb*/
> gen riot=index1_smsa
> replace riot=0 if year==1970
> replace riot=0 if bigside_m==0
> areg lnavval yesbig1980 big1980 riot A* if tierno<2 & year!=1960 [aw=house_ownocc], absorb(extra) cluster(jurcode)
> */
. 
. /*
> /** The 1960 block-level data is not included in the AEJ data archive. Please contact me at lboustan@econ.ucla.edu for access 
> to this data **/
> /* Bottom row of Table 5*/
> /* Merge in 1960 data for placebo*/
> drop tract* county 
> append using ~/Tract_block/1960/block_data_0825
> /* Outlier in house_ownocc = 11500. next largest is 400 something*/
> replace house_ownocc=. if house_ownocc>1000 & year==1960
> /* Replace peroo for 1960 (do not have actual percents)*/
> replace peroo=(house_ownocc/house_tot) if year==1960
> /* (1) Yesorder_m & bigside_m - include 1960*/
> sort borderno
> by borderno: egen yesorder_mm=max(yesorder_m)
> sort borderno jurcode
> by borderno jurcode: egen bigside_mm=max(bigside_m)
> /* (2) Fixed effects - include 1960*/
> drop if year==1980
> drop extra* A*
> /* Fixed effect for side of the border (jurisdiction * border area)*/
> egen extra=group(jurcode borderno)
> egen extra1=group(borderno year)
> /*Border area by time fixed effects*/
> xi, pref(A) i.borderno*i.year
> replace lnpoptot=ln(poptot) if year==1960
> replace lnavval=ln(av_value) if year==1960
> replace lnavrent=ln(av_rent) if year==1960
> /* (3) Flag for borders that have some observations in 1960*/
> drop flag*
> gen flag=(year==1960)
> sort borderno
> by borderno: egen flagmax=max(flag)
> /* Exclude altogether borders that had some desegregation over the 1960s - e.g., Pasadena and LA*/
> replace flagmax=0 if borderno==27 |  borderno==31 | borderno==14 | borderno==309 | borderno==310 | borderno==330
> /* Regressions with 1960 observations*/
> /* Gaps in 1960 - by type*/
> #delimit ;
> areg lnavval bigside_mm if tierno<2 & year==1960 & yesorder_mm==1 & flagmax==1 [aw=house_ownocc], absorb(borderno) 
> cluster(jurcode);
> areg lnavval bigside_mm if tierno<2 & year==1960 & yesorder_mm==0 & flagmax==1 [aw=house_ownocc], absorb(borderno) 
> cluster(jurcode);
> /* Gaps in 1970 - by type*/
> areg lnavval bigside_mm if tierno<2 & year==1970 & yesorder_mm==1 & flagmax==1 [aw=house_ownocc], absorb(borderno) 
> cluster(jurcode);
> areg lnavval bigside_mm if tierno<2 & year==1970 & yesorder_mm==0 & flagmax==1 [aw=house_ownocc], absorb(borderno) 
> cluster(jurcode);
> /* Gaps in 1960 or 1970 - order vs. not*/
> gen yesbig01=yesorder_mm*bigside_mm;
> areg lnavval bigside_mm yesbig01 if tierno<2 & year==1960 & flagmax==1 [aw=house_ownocc], absorb(borderno) cluster(jurcode);
> areg lnavval bigside_mm yesbig01 if tierno<2 & year==1970 & flagmax==1 [aw=house_ownocc], absorb(borderno) cluster(jurcode);
> drop Cyear_1970;
