. /* (2) Define fixed effects*/
. /* Fixed effect for side of the border (jurisdiction * border area)*/
. egen extra=group(jurcode borderno)

. /* Common fixed effect for border area in given Census year*/
. egen extra1=group(borderno year)

. /*Border area by time fixed effects*/
. xi, pref(A) i.borderno*i.year
i.borderno        Aborderno_1-330     (naturally coded; Aborderno_310 omitted)
i.year            Ayear_1970-1980     (naturally coded; Ayear_1970 omitted)
i.bor~o*i.year    AborXyea_#_#        (coded as above)

