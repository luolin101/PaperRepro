. ** MERGE DATA FROM 1970 AND 1980
. 
. /* Start with block-level data from 1980 */
. use ~/Tract_block/1980/blockdata_1980.dta  

. /* Adjust variable names to merge with the 1970 data*/
. rename year year_case

. rename smsa smsa_string

. rename state state_string

. rename place place_string

. gen year=1980

. rename lnav_value lnavval

. rename lnav_rent lnavrent

. rename perblack1 perblack

. rename av_rooms av_rooms_oo

. drop full

. set more off

