log using merge_CCDB.log, replace/* This do file collapses down the block-level dataset to a district-by-borderarea level dataset. It then merges this district data (which has desegregation information) with housing values and rents data from the City and County Databook files. It then produces the results for Table 6*//*Make a dataset with one obseration per jurisdiction per border area*/do deseg_results_aejreplace poptot=totpop if year==1980/* Adjust names on some districts to merge with CCDB*/replace name="SAN FRANCISCO" if jurcode=="sanfraca" & name==""replace name="DAVENPORT" if jurcode=="davenpia" & name==""replace name="ST PAUL" if name=="ST. PAUL"replace name="ST LOUIS" if name=="ST. LOUIS"/* Keep only district-level variables, esp. those pertaining to desegregation*/keep yesorder_m poptot bigside_m borderno name statefip year jurcode shblacksort year borderno jurcodekeep if jurcode!=jurcode[_n-1] sort name statefipsave merge_CCDB.dta, replace/* Merge in 1970 data*/drop if year==1980merge name statefip using ~/Suburban/Data/CCDB_data/uscity72.dtadrop if _merge==2drop if name=="NEW YORK CITY" & county!=0keep yesorder_m poptot bigside_m borderno name statefip year jurcode var310 var311 var378 var386 var387 var388 shblack/* Share of the population in the district that are school-age children*/gen per517=(100-var311-var310)/100gen per04=var310/100gen peroo=var386/100/* Average housing prices and rents in district*/gen av_value=var387*4.43gen av_rent=var388*4.43rename var378 av_roomsdrop var3*save merge_CCDB_01.dta, replace/* Merge in 1980 data*//**/* First need to get rid of the "comma state" at the end of every city name*/use ~/Suburban/Data/CCDB_data/uscity83.dtagen name1=reverse(name)gen name2=length(name1)gen name3=substr(name1,5,name2)gen name_only=reverse(name3)label var name_only "city name without state at end"drop name1-name3sort name_only statefipsave ~/Suburban/Data/CCDB_data/uscity83.dta, replace**/clearuse merge_CCDB.dtasort jurcode yearreplace name=name[_n-1] if year==1980 & jurcode==jurcode[_n-1]drop if year==1970rename name name_only/* Adjust some district names to merge with CCDB*/replace name_only="ST. LOUIS" if name_only=="ST LOUIS"replace name_only="ST. PAUL" if name_only=="ST PAUL"replace name_only="NEW YORK" if name_only=="NEW YORK CITY"drop if jurcode=="losangca" & statefip==.sort name_only statefipmerge name_only statefip using ~/Suburban/Data/CCDB_data/uscity83.dtadrop if _merge==2#delimit ;keep yesorder_m poptot bigside_m borderno name statefip year jurcode var3 var13 var14 var54 var55 var57 var59 name_only shblack;#delimit crgen per517=var14/var3gen per04=var13/var3gen peroo=var55/var54gen av_value=var57*2.1gen av_rent=var59*2.1drop var*append using merge_CCDB_01.dtatab year/* Create year *  borderno interaction dummy variables*/egen extra=group(year borderno)gen lnpop=ln(poptot)save merge_CCDB_01.dta, replace/* Table 6 results*//* Rows 1 & 2: Columns 1 & 2. Results by whether or not under court order and by year*/areg lnav_value bigside_m if year==1970 & yesorder_m==1, absorb(borderno)areg lnav_value bigside_m if year==1970 & yesorder_m==0, absorb(borderno)areg lnav_value bigside_m if year==1980 & yesorder_m==1, absorb(borderno)areg lnav_value bigside_m if year==1980 & yesorder_m==0, absorb(borderno)/* Generate relevant dummy variables to conduct difference-in-differences. See main file (deseg_results_aej.do) for labels*/gen yesbig=yesorder_m*bigside_mgen Y1980=(year==1980)gen Y1970=(year==1970)gen big1970=bigside_m*Y1970gen yesbig1970=yesbig*Y1970gen big1980=bigside_m*Y1980gen yesbig1980=yesbig*Y1980/* Rows 1 & 2: Column 3*/areg lnav_value bigside_m yesbig if year==1970, absorb(borderno)areg lnav_value bigside_m yesbig if year==1980, absorb(borderno)/* Row 3*/egen extra1=group(borderno jurcode)xi, pref(A) i.borderno*i.yearareg lnav_value yesbig1980 bigside_m yesbig big1980 A* if yesorder_m==1 & year>=1970, absorb(extra1)areg lnav_value yesbig1980 bigside_m yesbig big1980 A* if yesorder_m==0 & year>=1970, absorb(extra1)areg lnav_value yesbig1980 bigside_m yesbig big1980 A* if year>=1970, absorb(extra1)areg lnav_value bigside_m yesbig big1980 yesbig1980 if year>=1970, absorb(extra)/* Other dependent variables*/areg shblack bigside_m yesbig big1980 yesbig1980 A* if yesorder_m==1 & year>=1970, absorb(extra1)areg shblack bigside_m yesbig big1980 yesbig1980 A* if yesorder_m==0 & year>=1970, absorb(extra1)areg shblack bigside_m yesbig big1980 yesbig1980 A* if year>=1970, absorb(extra1)areg per517 bigside_m yesbig big1980 yesbig1980 A* if yesorder_m==1 & year>=1970, absorb(extra1)areg per517 bigside_m yesbig big1980 yesbig1980 A* if yesorder_m==0 & year>=1970, absorb(extra1)areg per517 bigside_m yesbig big1980 yesbig1980 A* if year>=1970, absorb(extra1)/*For Table 3*/sort year bigside_m namesumm per04 per517 shblack av_value av_rent peroo av_rooms if name!=name[_n-1] & year==1970 & bigside_m==1/* Row 4: Pre-trend*/expand 2 if year==1970sort borderno jurcode yearreplace year=1960 if year==1970 & year[_n+1]==1970 & jurcode==jurcode[_n+1] & borderno==borderno[_n+1]foreach var of varlist per517 per04 peroo av_value av_rent lnpop av_rooms {  replace `var'=. if year==1960}sort name statefip yearmerge name statefip year using ~/Suburban/Data/CCDB_data/uscity62.dtadrop if _merge==2keep yesorder_m poptot bigside_m borderno name statefip year jurcode var360 var362 per517 per04 peroo av_value av_rent lnpop extra*$replace av_value=var360*5.725 if year==1960replace av_rent=var362*5.725 if year==1960gen lnav_value=ln(av_value)gen lnav_rent=ln(av_rent)drop var*areg lnav_value yesbig1970 bigside_m yesbig big1970 A* if year<=1970, absorb(extra1)areg lnav_value yesbig1970 bigside_m yesbig big1970 A* if yesorder_m==1 & year<=1970, absorb(extra1)areg lnav_value yesbig1970 bigside_m yesbig big1970 A* if yesorder_m==0 & year<=1970, absorb(extra1)log close