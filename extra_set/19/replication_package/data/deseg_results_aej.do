log using deseg_results_aej.log, replaceclear clear matrixclear mataset mem 100mset matsize 800** MERGE DATA FROM 1970 AND 1980/* Start with block-level data from 1980 */use ~/Tract_block/1980/blockdata_1980.dta  /* Adjust variable names to merge with the 1970 data*/rename year year_caserename smsa smsa_stringrename state state_stringrename place place_stringgen year=1980rename lnav_value lnavvalrename lnav_rent lnavrentrename perblack1 perblackrename av_rooms av_rooms_oodrop fullset more offappend using ~/Tract_block/OCR_school/Matt/block_1970_withhs_aej.dta** ADJUST DATA TO MAKE CONSISTENT BETWEEN TWO YEARS/* (1) Ensure consistent jurisdiction sample in 1970 and 1980 *//* Drop South (Georgia)*/drop if statefip==13/* Drop NYC-Floral Park (Floral Park too small - jurisdiction data not available)*/drop if borderno==44/* Make sure that St. Louis jurisdiction code is consistent across years*/replace jurcode="stlouimo" if year==1970 & jurcode=="sailoumo"/* Drop borders for which jurisdiction on one side is smaller than 10,000 residents */gen flag_lowpop=(poptot<10000)sort year bordernoquietly by year borderno: egen flag_lowpop_any=max(flag_lowpop)drop if flag_lowpop_any==1/* Drop borders if only one side has data in a given year*/sort year borderno jurcodegen test=(jurcode!=jurcode[_n-1])sort year bordernoby year borderno: egen test1=sum(test)drop if test1==1count if test==1drop test* flag*/* Drop borders only present in 1970 or 1980*/sort year bordernogen test=(borderno!=borderno[_n-1])sort bordernoby borderno: egen test1=sum(test)drop if test1==1count if test==1drop test*/* (2) Define fixed effects*//* Fixed effect for side of the border (jurisdiction * border area)*/egen extra=group(jurcode borderno)/* Common fixed effect for border area in given Census year*/egen extra1=group(borderno year)/*Border area by time fixed effects*/xi, pref(A) i.borderno*i.year/* (3) Adjust dependent variables for consistency between years*/replace lnavval=ln(av_value) if lnavval==.replace lnavrent=ln(av_rent) if lnavrent==./* Drop observations with no residents on the block*/drop if pop_tot_block==0/* Log number of residents & number of units on the block*/gen lnpopblock=ln(pop_tot_block)gen lnct3_tot=ln(ct3_tot)label var lnpopblock "ln(# residents on block)"label var lnct3_tot "ln(# units on block)"/* Vacancies*/gen numvac=pervac*ct3_totgen shvac=numvac/ct3_totlabel var numvac "# of vacant units on block"label var shvac "Share units vacant on block"/* User cost of housing*//* Weighted average of borrowing costs for owner-occupied (assume 9% interest rate for the 1970s) and annual rental costs for rental units. Need housing counts to be zero if there is no information on either rents/values*/replace house_ownocc=0 if lnavval==.foreach var of varlist av_value av_rent house_ownocc house_rent {	replace `var'=0 if `var'==.}gen av_cost=((av_value*.09*house_ownocc)+(av_rent*12*house_rent))/(house_rent+house_ownocc)gen lnavcost=ln(av_cost)gen house_all=house_ownocc+house_rentlabel var av_cost "Average user cost on block (weighted average of rents/borrowing costs)"label var lnavcost "Ln(average user costs)"label var house_all "# of renter-occupied & owner-occupied units"/*Age distribution on block*/rename perund18 shkids/* (4) City-wide controls -- Fill in missing information for two places*/replace shblack=(4099/98477) if year==1970 & jurcode=="davenpia"replace shblack=(6229/103264) if year==1980 & jurcode=="davenpia"replace shblack=(95845/715674) if year==1970 & jurcode=="sanfraca"replace shblack=(86190/678974) if year==1980 & jurcode=="sanfraca"replace poptot=98477 if year==1970 & jurcode=="davenpia"replace totpop=103264 if year==1980 & jurcode=="davenpia"replace poptot=715674 if year==1970 & jurcode=="sanfraca"replace totpop=678974 if year==1980 & jurcode=="sanfraca"replace shblack=.00001 if jurcode=="norarlnj" & year==1970gen lnshblack=ln(shblack)label var lnshblack "ln(share black in jurisdiction)"gen lnpoptot=ln(poptot)replace lnpoptot=ln(totpop) if year==1980/* (5) Desegregation variables*//* Focus on number of steps required by court (not on presence of individual steps, such as busing). First, create a district-level variable equal to maximum number of steps _ever_ required by court*/sort jurcodequietly by jurcode: egen number_stepsm=max(number_steps)sort borderno jurcodeby borderno jurcode: egen year_casem=max(year_case)/*Year specific desegregation variables = maximum number of variable in given year and zero else*/gen Cyear_1970=(year==1970)gen Cyear_1980=(year==1980)foreach var of varlist shblack lnmedinc number_stepsm perpov {	gen `var'70=`var'*Cyear_1970	gen `var'80=`var'*Cyear_1980}	/* Chicago was improperly coded as having 4 steps -- actually had no case that led to plan until after 1980*/replace number_stepsm80=0 if jurcode=="chicagil"replace number_stepsm70=0 if jurcode=="chicagil"/* Two desegregation variables of interest = # of steps in 1980 (or in 1970 if plan passes before then) or indicator =1 if desegregation plan passed by 1980*/gen deseg01=number_stepsm80replace deseg01=number_stepsm70 if year_casem<1970 & year==1970label var deseg01 "Number of remedial steps required by court, district by given year"gen deseg=(deseg01>0 & deseg01!=.)label var deseg "=1 if ever under court-order, district"/* Count total number of borders and number of borders with a desegregation plan*/sort year borderno jurcode/* Test = deseg indicator once per jurisdiction-borderno pair*/gen test=deseg if (jurcode!=jurcode[_n-1]) | (jurcode==jurcode[_n-1] &  borderno!=borderno[_n-1])/* Test1 counts deseg indicator for borderno*/sort year bordernoby year borderno: egen test1=total(test)/* Test1 = 0 means no desegregation on either side; test1 = 1 means desegregation on one side; test1 = 2 means desegregation on both sides*/count if year==1980 & borderno!=borderno[_n-1] & test1==0count if year==1980 & borderno!=borderno[_n-1] & test1==1count if year==1980 & borderno!=borderno[_n-1] & test1==2tab jurcode if test1==2sort borderno/* Treatment group = desegregation on only one side of border area*/gen flag=(test1==1 & year==1980)/*For footnote: Matching with Welch and Light years*/*replace flag=1 if jurcode=="akronoh"*replace flag=0 if jurcode=="sanjosca"/* Replace borders that had cases in the 1960s as part of "control group"*/gen earlycase=(borderno==27 | borderno==14 | borderno==309 | borderno==310 | borderno==330)replace flag=0 if earlycase==1/* Yesorder_m ==> Border area level variable = 1 if border in treatment group (only one side had desegregation)*/by borderno: egen yesorder_m=max(flag)gen yes1980=yesorder_m*Cyear_1980/* Double_m ==> Border area level variable if BOTH sides had desegregation... subcomponent of control group*/gen flag1=(test1==2 & year==1980)by borderno: egen double_m=max(flag1)drop test* flag*/* Count borders in treatment group and control group*/sort year bordernocount  if year==1970 & yesorder_m==1 & borderno!=borderno[_n-1]count  if year==1970 & yesorder_m==0 & borderno!=borderno[_n-1]count  if year==1980 & yesorder_m==1 & borderno!=borderno[_n-1]count  if year==1980 & yesorder_m==0 & borderno!=borderno[_n-1]/* Generate an "ever desegregate" variable at the jurisdiction and borderno levels*/sort jurcodeby jurcode: egen desegmax=max(deseg)sort bordernoby borderno: egen maxdesegmax=max(desegmax)/*Indicate which side of the border is bigger in population terms*/sort year bordernoby year borderno: egen popmax=max(poptot)gen bigside=(popmax==poptot)drop popmax/* Extend "bigside" of border to 1980 as well*/sort borderno jurcodegen test=bigside if year==1970by borderno jurcode: egen bigside_m=max(test)/* Replace one case where desegregation occurred on "small" side of border*/replace bigside_m=1 if jurcode=="pasadeca" & borderno==14replace bigside_m=0 if jurcode=="losangca" & borderno==14/*(6) Fix metro area variable*/replace metaread=1120 if (smsa=="Boston" | jurcode=="bostonma" | jurcode=="dedhamma") & metaread==.replace metaread=1600 if (smsa=="Chicago" | jurcode=="chicagil" | jurcode=="eveparil" | jurcode=="norridil") & metaread==.replace metaread=1680 if smsa=="Cleveland" & metaread==.replace metaread=2000 if smsa=="Dayton" & metaread==.replace metaread=4480 if (smsa=="Los Angeles" | jurcode=="bevhilca" | jurcode=="culcitca" | jurcode=="losangca") & metaread==.replace metaread=5120 if (smsa=="Minneapolis-St. Paul" | jurcode=="colheimn" | jurcode=="minneamn") & metaread==.replace metaread=5600 if smsa=="New York City" & metaread==.replace metaread=6280 if smsa=="Pittsburgh" & metaread==.replace metaread=6480 if smsa=="Providence" & metaread==.replace metaread=1960 if (smsa=="Rock Island-Davenport-Moline" | jurcode=="davenpia" | jurcode=="bettenia")  & metaread==.replace metaread=7360 if (smsa=="San Francisco" | jurcode=="sanfraca" | jurcode=="dalcitca") & metaread==.replace metaread=7400 if smsa=="San Jose" & metaread==.replace metaread=2080 if (jurcode=="denverco" | jurcode=="englewco" | jurcode=="lakewoco") & metaread==.#delimit ;replace metaread=2160 if (smsa=="Detroit" | jurcode=="deaheimi" | jurcode=="detroimi" | jurcode=="easdetmi" | jurcode=="gropoimi" |jurcode=="harwoomi") & metaread==.;replace metaread=3760 if (smsa=="Kansas City" | jurcode=="kancitks" | jurcode=="kancitmo" | jurcode=="oveparks" | jurcode=="raytowmo") & metaread==.;#delimit crdrop smsa*/* Table 1: Initial characteristics of urban school districts*//* Differences between 'big side' with and without desegregation*/sort year bigside jurcode double_mforeach var of varlist lnpoptot shblack lnmedinc perpov peredcol {sum `var' if yesorder_m==0 &  year==1970 & jurcode!=jurcode[_n-1] & bigside_m==1sum `var' if yesorder_m==1 &  year==1970 & jurcode!=jurcode[_n-1] & bigside_m==1reg `var' yesorder_m if year==1970 & jurcode!=jurcode[_n-1] & bigside_m==1areg `var' Cyear_1980 if yesorder_m==1 & jurcode!=jurcode[_n-1] & bigside_m==1, absorb(jurcode) areg `var' Cyear_1980 if yesorder_m==0 & jurcode!=jurcode[_n-1] & bigside_m==1, absorb(jurcode)areg `var' yes1980 Cyear_1980 if jurcode!=jurcode[_n-1] & bigside_m==1, absorb(jurcode) }drop test*/* Table 2: List of borders in the sample*/sort year borderno bigside_mgen test=(borderno!=borderno[_n+1])tab jurcode if test==1 & year==1970 & bigside_m==1drop test*/* Table 3: Summary stats for border sample*/gen shkids01=shkids-per04/* Full sample of blocks: Reported in column 1*/summ perblack ct3_tot peroo per04 shkids01 if year==1970 & tierno==1summ perblack ct3_tot peroo per04 shkids01 if year==1970 & tierno==1 & bigside_m==1summ perblack ct3_tot peroo per04 shkids01 if year==1970 & tierno==1 & bigside_m==0/* Blocks with at least 5 owner-occ units*/summ av_value av_rooms_oo if year==1970 & tierno==1 & lnavval!=. summ av_value av_rooms_oo if year==1970 & tierno==1 & lnavval!=. & bigside_m==1summ av_value av_rooms_oo if year==1970 & tierno==1 & lnavval!=. & bigside_m==0/* Blocks with at least 5 rental units*/summ av_rent if year==1970 & tierno==1 & lnavrent!=. summ av_rent if year==1970 & tierno==1 & lnavrent!=. & bigside_m==1summ av_rent if year==1970 & tierno==1 & lnavrent!=. & bigside_m==0/* See below for Table 4 - Exposure results*//* Table 5: Price results*//* Gaps in 1970 - if order by 1980*/areg lnavval desegmax if tierno<2 & year==1970 & yesorder_m==1 [aw=house_ownocc], absorb(borderno) cluster(jurcode)/* Gaps in 1970 - if no order by 1980*/areg lnavval bigside_m if tierno<2 & year==1970 & yesorder_m==0 [aw=house_ownocc], absorb(borderno) cluster(jurcode)/* Gaps in 1980 - if order by 1980*/areg lnavval desegmax if tierno<2 & year==1980 & yesorder_m==1 [aw=house_ownocc], absorb(borderno) cluster(jurcode)/* Gaps in 1980 - if no order by 1980*/areg lnavval bigside_m if tierno<2 & year==1980 & yesorder_m==0 [aw=house_ownocc], absorb(borderno) cluster(jurcode)/* 1970: Order vs. no order*/gen yesbig=yesorder_m*bigside_mareg lnavval bigside_m yesbig if tierno<2 & year==1970 [aw=house_ownocc], absorb(borderno) cluster(jurcode)/* 1980: Order vs. no order*/areg lnavval bigside_m yesbig if tierno<2 & year==1980 [aw=house_ownocc], absorb(borderno) cluster(jurcode)/* 1970 vs. 1980: Order*/gen yesbig1980=yesbig*Cyear_1980gen big1980=bigside_m*Cyear_1980areg lnavval bigside_m big1980 Cyear_1980 if tierno<2 & yesorder_m==1 [aw=house_ownocc], absorb(borderno) cluster(jurcode)areg lnavval big1980 Cyear_1980 A* if tierno<2 & yesorder_m==1 [aw=house_ownocc], absorb(extra) cluster(jurcode)/* 1970 vs. 1980: No order*/areg lnavval bigside_m big1980 Cyear_1980 if tierno<2 & yesorder_m==0 [aw=house_ownocc], absorb(borderno) cluster(jurcode)areg lnavval big1980 Cyear_1980 A* if tierno<2 & yesorder_m==0 [aw=house_ownocc], absorb(extra) cluster(jurcode)/* Full sample*/areg lnavval yesbig1980 big1980 bigside_m yesbig if tierno<2 [aw=house_ownocc], absorb(extra1) cluster(jurcode)areg lnavval yesbig1980 big1980 A* if tierno<2 [aw=house_ownocc], absorb(extra) cluster(jurcode)/* See below for last row of Table 5 - 1960 to 70 placebo*//* Table 7: Other dependent variables *//* Rent*/areg lnavrent big1980 Cyear_1980 A* if tierno<2 & yesorder_m==1 [aw=house_rent], absorb(extra) cluster(jurcode)areg lnavrent big1980 Cyear_1980 A* if tierno<2 & yesorder_m==0 [aw=house_rent], absorb(extra) cluster(jurcode)areg lnavrent yesbig1980 big1980 A*  if tierno<2  [aw=house_rent], absorb(extra) cluster(jurcode)/* User cost*/areg lnavcost big1980 Cyear_1980 A* if tierno<2 & yesorder_m==1 [aw=house_all], absorb(extra) cluster(jurcode)areg lnavcost big1980 Cyear_1980 A* if tierno<2 & yesorder_m==0 [aw=house_all], absorb(extra) cluster(jurcode)areg lnavcost yesbig1980 big1980 A* if tierno<2 [aw=house_all], absorb(extra) cluster(jurcode)/* Average rooms*/*gen lnavrooms=ln(av_rooms_oo)areg av_rooms_oo big1980 Cyear_1980 A* if tierno<2 & yesorder_m==1 & lnavval!=., absorb(extra) cluster(jurcode)areg av_rooms_oo big1980 Cyear_1980 A* if tierno<2 & yesorder_m==0 & lnavval!=., absorb(extra) cluster(jurcode)areg av_rooms_oo yesbig1980 big1980 A* if tierno<2 & lnavval!=., absorb(extra) cluster(jurcode)/* Percent black*/areg perblack big1980 Cyear_1980 A* if tierno<2 & yesorder_m==1, absorb(extra) cluster(jurcode)areg perblack big1980 Cyear_1980 A* if tierno<2 & yesorder_m==0, absorb(extra) cluster(jurcode)areg perblack yesbig1980 big1980 A* if tierno<2, absorb(extra) cluster(jurcode)/* Share kids*/areg shkids01 big1980 Cyear_1980 A* if tierno<2 & yesorder_m==1, absorb(extra) cluster(jurcode)areg shkids01 big1980 Cyear_1980 A* if tierno<2 & yesorder_m==0, absorb(extra) cluster(jurcode)areg shkids01 yesbig1980 big1980 A* if tierno<2, absorb(extra) cluster(jurcode)/* Percent owner occupied*/areg peroo big1980 Cyear_1980 A* if tierno<2 & yesorder_m==1, absorb(extra) cluster(jurcode)areg peroo big1980 Cyear_1980 A* if tierno<2 & yesorder_m==0, absorb(extra) cluster(jurcode)areg peroo yesbig1980 big1980 A* if tierno<2, absorb(extra) cluster(jurcode)/* Number of units*/areg lnct3_tot big1980 Cyear_1980 A* if tierno<2 & yesorder_m==1, absorb(extra) cluster(jurcode)areg lnct3_tot big1980 Cyear_1980 A* if tierno<2 & yesorder_m==0, absorb(extra) cluster(jurcode)areg lnct3_tot yesbig1980 big1980 A* if tierno<2, absorb(extra) cluster(jurcode)*areg lnct3_tot yesbig1980 big1980 A* if tierno<2, absorb(extra) cluster(jurcode)/*Table 8: Alternative specifications*//* Add %black*/areg lnavval yesbig1980 big1980 perblack A* if tierno<2 [aw=house_ownocc], absorb(extra) cluster(jurcode)/* Add # rooms*/areg lnavval yesbig1980 big1980 av_rooms_oo A* if tierno<2 [aw=house_ownocc], absorb(extra) cluster(jurcode)/* Main results without 'early case' borders in the control group*/* Replace absorb(extra) with extra as dummy variables in order to estimate* Check also without weights and with lnavcost as DVareg lnavval yesbig1980 big1980 A* if tierno<2 & earlycase==0 [aw=house_ownocc], absorb(extra) cluster(jurcode)/* Drop borders in which both sides were desegregated in 1970s from the control group*/areg lnavval yesbig1980 big1980 A* if tierno<2 & double_m==0 [aw=house_ownocc], absorb(extra) cluster(jurcode)/* Drop Los Angeles*/areg lnavval yesbig1980 big1980 A* if tierno<2 & metaread!=4480 [aw=house_ownocc], absorb(extra) cluster(jurcode)/* Don't weight by number of houses*/areg lnavval yesbig1980 big1980 A* if tierno<2, absorb(extra) cluster(jurcode)/* Weight each border equally*/sort year borderno tiernoby year borderno tierno: egen count=count(tierno)gen test=count if tierno==1sort year bordernoby year borderno: egen test1=max(test)gen weight1=1/test1drop test*areg lnavval yesbig1980 big1980 A* if tierno<2 [aw=weight1], absorb(extra) cluster(jurcode)/* RHS: Count number of steps*/areg lnavval deseg01 A* if tierno<2 [aw=house_ownocc], absorb(extra) cluster(jurcode)/* Add % black and lnpop in town*/areg lnavval yesbig1980 big1980 shblack lnpoptot A* if tierno<2 [aw=house_ownocc], absorb(extra) cluster(jurcode)/* Less than 2% black*/areg lnavval yesbig1980 big1980 A* if tierno<2 & perblack<=.02 [aw=house_ownocc], absorb(extra) cluster(jurcode)/* Table 9: Heterogeneous responses*//* Interact with % black at nearest high school before desegregation (in 1970)*/sort borderno jurcodeby borderno jurcode: egen perenr_bl1970=mean(perenr_black1)gen big1980per=big1980*perenr_bl1970gen yesbig1980per=yesbig1980*perenr_bl1970/* Interaction with actual black enrollment in 1970*/areg lnavval big1980 yesbig1980 big1980per yesbig1980per A* if tierno<2 [aw=house_ownocc], absorb(extra) cluster(jurcode)areg lnavval big1980 yesbig1980 big1980per yesbig1980per A* if tierno<2 & perblack<.02 [aw=house_ownocc], absorb(extra) cluster(jurcode)areg lnavcost big1980 yesbig1980 big1980per yesbig1980per A* if tierno<2 & perblack<.02 [aw=house_all], absorb(extra) cluster(jurcode)/*Interaction with _difference_ between local % black and % in district*/gen excess_bl1970=(shblack-perenr_bl1970)gen big1980exc=big1980*excess_bl1970gen yesbig1980exc=yesbig1980*excess_bl1970areg lnavval big1980 yesbig1980 big1980exc yesbig1980exc A* if tierno<2 [aw=house_ownocc], absorb(extra) cluster(jurcode)areg lnavval big1980 yesbig1980 big1980exc yesbig1980exc A* if tierno<2 & perblack<.02 [aw=house_ownocc], absorb(extra) cluster(jurcode)/*Try dummy for any black students instead of linear specification*/gen any_bl1970=(perenr_bl1970>.02 & perenr_bl1970!=.)gen big1980any=big1980*any_bl1970gen yesbig1980any=yesbig1980*any_bl1970areg lnavval big1980 yesbig1980 big1980any yesbig1980any A* if tierno<2 [aw=house_ownocc], absorb(extra) cluster(jurcode)areg lnavval big1980 yesbig1980 big1980any yesbig1980any A* if tierno<2 & perblack<.02 [aw=house_ownocc], absorb(extra) cluster(jurcode)/* Table 10: School revenues and expenditures*//*Merge in school spending data to see if desegregated districts got more funding*/sort jurcode yearmerge jurcode year using ~/Tract_block/OCR_district/ELSEGIS_1970.dtatab _mergerename _merge _merge1970sort jurcode yearmerge jurcode year using ~/Tract_block/OCR_district/ELSEGIS_1980.dta, updatetab _mergerename _merge _merge1980replace revschfed_pup=revschfed1_pup+revschfed2_pup+revschfed3_pup+revschfed4_pup+revschfed5_pup+revschfed6_pup if year==1980sort year borderno jurcodeareg revschfed_pup yesbig1980 Cyear_1980 bigside_m big1980 yesbig if jurcode!=jurcode[_n-1], absorb(borderno) cluster(jurcode)areg revschsta_pup yesbig1980 Cyear_1980 bigside_m big1980 yesbig if jurcode!=jurcode[_n-1], absorb(borderno) cluster(jurcode)areg revschtax_pup yesbig1980 Cyear_1980 bigside_m big1980 yesbig if jurcode!=jurcode[_n-1], absorb(borderno) cluster(jurcode)areg ceadm_pup yesbig1980 Cyear_1980 bigside_m big1980 yesbig if jurcode!=jurcode[_n-1], absorb(borderno) cluster(jurcode)areg 